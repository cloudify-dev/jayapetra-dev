# Database yayasan_cms (yang sudah ada, dari yayasan_cms.sql)
# MAMP: port 8889 | MySQL default: port 3306
DATABASE_URL="mysql://root:root@localhost:8889/yayasan_cms"

# JWT
JWT_ACCESS_SECRET=your-access-token-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=4000
BASE_URL=http://localhost:4000

# Upload (default: cms/public/uploads agar file Strapi tetap dipakai)
UPLOAD_DIR=../cms/public/uploads

# Seed admin (optional)
ADMIN_EMAIL=admin@yakapetra.org
ADMIN_PASSWORD=Admin123!
